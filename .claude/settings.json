{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "enableAllProjectMcpServers": true,
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "*",
      "mcp__*",
      "read_file(*)",
      "write_file(*)",
      "read_url(*)",
      "command(*)",
      "PowerShell(*)",
      "Bash(*)"
    ]
  }
}
