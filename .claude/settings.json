{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "enableAllProjectMcpServers": true,
  "env": {
    "MCP_TIMEOUT": "120000"
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "mcp__brightdata",
      "mcp__brightdata__*",
      "mcp__firecrawl-mcp",
      "mcp__firecrawl-mcp__*",
      "mcp__Apify",
      "mcp__Apify__*",
      "mcp__playwright",
      "mcp__playwright__*",
      "mcp__github",
      "mcp__github__*",
      "mcp__yfinance",
      "mcp__yfinance__*",
      "mcp__sec-edgar-mcp",
      "mcp__sec-edgar-mcp__*",
      "mcp__pymupdf4llm-mcp",
      "mcp__pymupdf4llm-mcp__*",
      "mcp__Exa",
      "mcp__Exa__*",
      "mcp__Claude_Docs",
      "mcp__Claude_Docs__*",
      "mcp__claude-code-remote",
      "mcp__claude-code-remote__*",
      "mcp__Claude_Code_Remote",
      "mcp__Claude_Code_Remote__*",
      "mcp__claude_ai_Apify",
      "mcp__claude_ai_Apify__*",
      "mcp__claude_ai_brightdata",
      "mcp__claude_ai_brightdata__*",
      "mcp__claude_ai_firecrawl-mcp",
      "mcp__claude_ai_firecrawl-mcp__*",
      "mcp__claude_ai_Exa",
      "mcp__claude_ai_Exa__*",
      "mcp__claude_ai_Claude_Docs",
      "mcp__claude_ai_Claude_Docs__*",
      "mcp__claude_ai_Claude_Code_Remote",
      "mcp__claude_ai_Claude_Code_Remote__*",
      "mcp__Google_Drive",
      "mcp__Google_Drive__*",
      "mcp__FMP",
      "mcp__FMP__*",
      "mcp__Morningstar_Credit_Analytics",
      "mcp__Morningstar_Credit_Analytics__*",
      "mcp__Nimble",
      "mcp__Nimble__*",
      "mcp__claude_ai_Google_Drive",
      "mcp__claude_ai_Google_Drive__*",
      "mcp__claude_ai_FMP",
      "mcp__claude_ai_FMP__*",
      "mcp__claude_ai_Morningstar_Credit_Analytics",
      "mcp__claude_ai_Morningstar_Credit_Analytics__*",
      "mcp__claude_ai_Nimble",
      "mcp__claude_ai_Nimble__*",
      "WebSearch",
      "WebFetch",
      "*",
      "mcp__*",
      "read_file(*)",
      "write_file(*)",
      "read_url(*)",
      "command(*)",
      "PowerShell(*)",
      "Bash(*)"
    ]
  },
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "^mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PermissionRequest\",\"decision\":{\"behavior\":\"allow\"}}}'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
