{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "yfinance": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/Alex2Yang97/yahoo-finance-mcp@81dcf33d69a8808696820e55373028741584b1ae",
        "--with",
        "mcp<2",
        "yahoo-finance-mcp"
      ],
      "env": {
        "PYTHONPATH": ".claude/mcp-patch"
      }
    },
    "sec-edgar-mcp": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/stefanoamorelli/sec-edgar-mcp.git@7442398fa62803ab0a250284dbe7a09542eeb632",
        "sec-edgar-mcp"
      ],
      "env": {
        "SEC_EDGAR_USER_AGENT": "FinancialReport Research (a9303002@gmail.com)"
      }
    },
    "pymupdf4llm-mcp": {
      "command": "uvx",
      "args": [
        "--from",
        "pymupdf4llm-mcp==1.28.0",
        "--with",
        "mcp<2",
        "pymupdf4llm-mcp",
        "stdio"
      ]
    }
  }
}